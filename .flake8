[flake8]
max-line-length = 120

# ---------------------------------------------------------------------------
# Codes suppressed throughout this codebase
#
# The bulk of the ~2000 flake8 warnings are pre-existing style choices from
# the MATLAB-to-Python port (alignment spacing, comment formatting, trailing
# whitespace, etc.).  Rather than reformatting thousands of lines in one go,
# they are suppressed here so that CI focuses on real correctness issues.
# Style cleanup can be done incrementally via separate PRs.
#
# Codes that ARE still checked (must not appear):
#   E999  – syntax errors                       (always fatal)
#   W605  – invalid escape sequence in strings  (silent regex bug)
#   F821  – undefined names                     (real NameError at runtime)
# ---------------------------------------------------------------------------
extend-ignore =
    # Whitespace style
    E114, E117, E127, E128, E131,
    E203, E221, E225, E227, E231, E241, E251, E261, E262, E265, E271, E275,
    # Blank-line style
    E302, E303, E305, E306,
    # Import ordering / placement
    E401, E402,
    # Line length (enforced by max-line-length above)
    E501,
    # Redundant backslash
    E502,
    # Statement style (one-liners, semicolons, bare except)
    E701, E702, E703, E722,
    # Whitespace around operators (style)
    E201, E228,
    # Comparison style (None / True / False)
    E711, E712, E713,
    # Ambiguous variable names (l, O, I) – common in physics code
    E741,
    # Pyflakes: imports and unused bindings
    F401, F403, F405, F523, F811, F841,
    # Trailing whitespace / newlines
    W291, W292, W293, W391,
    # Line-break conventions
    W503, W504,
    # Indentation style
    E111,

exclude =
    .git,
    __pycache__,
    callbacks/tmp.py,
    callbacks/appClassOLD.py,
