         <property name="text">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Syntax Examples&lt;/span&gt;&lt;/p&gt;&lt;p&gt;• Union of B and C, then intersects with A:&lt;br/&gt;&lt;span style=&quot; font-family:'Consolas'; font-weight:700;&quot;&gt;A &amp;amp; (B | C)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;• A squared plus B times C (element-wisely), then transposed: &lt;br/&gt;&lt;span style=&quot; font-family:'Consolas'; font-weight:700;&quot;&gt;(A.^2 + B .* C)'&lt;/span&gt;&lt;/p&gt;&lt;p&gt;• Concatenates (on X-dimension) A's Rows 1-3 to B's Rows 4-to-last: &lt;br/&gt;&lt;span style=&quot; font-family:'Consolas'; font-weight:700;&quot;&gt;[A(1:3,:) ; B(4:end,:)]&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
